# -----------------------------------------------------------------------------
# DCVS Git Ignore Rules
# -----------------------------------------------------------------------------

# Dependencies
node_modules/
*/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Production build outputs
dist/
*/dist/
build/
*/build/

# Local Environment Variables & Secrets
.env
*.env
.env.local
.env.*.local
frontend/.env
archive/**/.env

# Operating System & Editor metadata
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Temporary test screenshots & cache
scratch/*.png
scratch/api_matrix_results.json
.cache/
tmp/
