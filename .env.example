# -----------------------------------------------------------------------------
# DCVS Frontend Environment Configuration (.env.example)
# Copy to .env for local overrides. In development, Vite proxies /api to ORDS.
# -----------------------------------------------------------------------------

# API Base URL (empty = default Vite proxy to /api -> http://localhost:8080/ords/dcvs/api)
VITE_API_BASE_URL=

# -----------------------------------------------------------------------------
# Automated API Test Suite (scripts/check-api.mjs) Environment Configuration
# Set these variables when running tests against an external ORDS instance.
# -----------------------------------------------------------------------------

DCVS_API_BASE=http://localhost:8080/ords/dcvs/api
DCVS_ADMIN_USER=admin
DCVS_ADMIN_PASS=YourAdminPasswordHere
DCVS_APPLICANT_USER=asha
DCVS_APPLICANT_PASS=YourApplicantPasswordHere
DCVS_VERIFIER_USER=verifier1
DCVS_VERIFIER_PASS=YourVerifierPasswordHere
DCVS_HR_USER=hr1
DCVS_HR_PASS=YourHrPasswordHere
